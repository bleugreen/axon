{
  "name": "@axon/sdk",
  "version": "0.3.6",
  "description": "Dependency-free TypeScript client for the Axon desktop automation daemon",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
