[Unit]
Description=Axon accessibility daemon
Documentation=https://github.com/bleugreen/axon
# Bound to the graphical session, not to login: AT-SPI only exists once a desktop is up, so a
# daemon started at the greeter would have nothing to talk to. Stopping the desktop stops Axon.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Type=simple because Axon does not implement sd_notify readiness. Systemd therefore considers the
# unit started as soon as the process execs, which is earlier than Axon can serve; the CLI's
# authenticated health round trip is the readiness contract, not this unit's state.
Type=simple
ExecStart=@EXEC@ serve
Restart=on-failure
RestartSec=2

# A bound on the blast radius, not a tuning knob. Axon's honest working set is tens of megabytes:
# the largest tree it will return is capped at 2,000 nodes and a capture holds one screenshot. A
# process past 512M is misbehaving, and one past 1G has been observed taking the whole machine down
# with it, so it is throttled first and killed second rather than allowed to exhaust the host. The
# restart above brings it straight back, which is a better outcome for everything else on the
# machine than a daemon that swaps a desktop to death.
MemoryHigh=512M
MemoryMax=1G

[Install]
WantedBy=graphical-session.target
