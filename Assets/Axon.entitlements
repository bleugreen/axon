<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The daemon app sends Apple events to Safari and Google Chrome for navigate, windows, and
       tabs. Under the hardened runtime a process without this entitlement is not allowed even to
       ask: TCC refuses instantly, presents no consent dialog, records no row, and the app never
       appears in System Settings > Privacy & Security > Automation. NSAppleEventsUsageDescription
       in Info.plist supplies the dialog's wording; this entitlement is what permits the dialog to
       exist at all. Both halves are required.

       Keep this list at exactly what Axon sends. Every entitlement widens the sandbox escape the
       hardened runtime otherwise closes. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
