#!/usr/bin/env python3
"""A GTK 3 window for the Linux live lanes: one button and one text entry, published on AT-SPI.

    scripts/linux-probe-window

The X11 live lane needs a window it owns for two jobs, and this is that window for both:

- A foreground holder that is on the accessibility bus. Foreground delivery refuses to activate a
  target while the frontmost window belongs to a process with no AT-SPI application, because it
  could not name -- and so could not give back -- what it would be taking the foreground from. A
  bench desktop routinely has exactly such a window up front (the DGX dashboard is a snap Firefox
  that is not on the bus), so a lane that wants activation to be proved, not refused, puts this
  window in front first.
- A recording target. GTK 3 publishes real screen extents on X11, which element-at-point needs to
  enrich a recorded click; GTK 4 reports zeroed extents there, which is why GNOME Calculator is not
  the target this is.

The program name is fixed so the daemon finds the application by it: AT-SPI names a GTK
application after `g_get_prgname()`, which would otherwise be this file's name. The entry takes
its accessible name explicitly because a GTK 3 entry has no label of its own to be found by.
"""

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

APPLICATION = "axon-probe-window"
TITLE = "Axon Probe Window"

GLib.set_prgname(APPLICATION)

window = Gtk.Window(title=TITLE)
window.set_default_size(480, 260)
window.connect("destroy", Gtk.main_quit)

box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
box.set_border_width(24)
button = Gtk.Button(label="Press me")
button.set_size_request(200, 60)
entry = Gtk.Entry()
entry.get_accessible().set_name("Recording note")
box.pack_start(button, False, False, 0)
box.pack_start(entry, False, False, 0)
window.add(box)
window.show_all()
entry.grab_focus()
Gtk.main()
