#!/usr/bin/env python3
"""One JSON-RPC request to a running Axon daemon's local socket, for the live lanes.

The MCP facade covers the public tool surface, but a few methods are socket-only -- the recording
lifecycle among them -- and a lane that wants to assert on one has no other way to ask. The daemon
serves one request per connection: connect, write one JSON object and a newline, read one
newline-terminated response, close. `sdk/python/axon/transport.py` is the reference for that
framing and this deliberately does not reimplement the client around it; it is one request and the
raw answer, so a workflow step can pipe it straight into `jq`.

Usage:
    scripts/axon-socket-request '{"jsonrpc":"2.0","id":1,"method":"recording.status","params":{}}'

The socket path comes from `AXON_SOCKET`, or from `XDG_RUNTIME_DIR` the way the daemon derives it.
"""

import json
import os
import socket
import sys

# Long enough for a loaded desktop to answer, short enough that a wedged daemon fails the step
# rather than the job's whole timeout.
TIMEOUT_S = 30.0
MAX_RESPONSE_BYTES = 64 * 1024 * 1024


def socket_path() -> str:
    explicit = os.environ.get("AXON_SOCKET")
    if explicit:
        return explicit
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        sys.exit("neither AXON_SOCKET nor XDG_RUNTIME_DIR is set, so the daemon socket is unknown")
    return os.path.join(runtime, "axon-v1.sock")


def main() -> int:
    if len(sys.argv) != 2:
        sys.exit(f"usage: {sys.argv[0]} '<json-rpc request object>'")
    request = sys.argv[1]
    # Parsed before it is sent, so a malformed request fails here with a readable message rather
    # than as an unexplained parse error from the daemon.
    json.loads(request)

    path = socket_path()
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(TIMEOUT_S)
        try:
            connection.connect(path)
        except OSError as error:
            sys.exit(f"could not reach the daemon socket at {path}: {error}")
        connection.sendall(request.encode("utf-8") + b"\n")
        chunks = bytearray()
        while b"\n" not in chunks:
            chunk = connection.recv(64 * 1024)
            if not chunk:
                break
            chunks.extend(chunk)
            if len(chunks) > MAX_RESPONSE_BYTES:
                sys.exit("the daemon's response exceeded the response ceiling")
    if not chunks:
        sys.exit("the daemon closed the connection without answering")
    sys.stdout.write(chunks.split(b"\n", 1)[0].decode("utf-8"))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
