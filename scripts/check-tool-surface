#!/usr/bin/env bash
# Byte-checks the checked-in tool-surface artifact against the Swift-owned contract.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
ARTIFACT="schema/tool-surface-v1.json"
TMP="$(mktemp "${TMPDIR:-/tmp}/tool-surface-v1.XXXXXX.json")"
trap 'rm -f "$TMP"' EXIT
GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null \
  swift run --disable-sandbox --quiet tool-surface-exporter "$TMP"
if [[ "${1:-}" == "--write" ]]; then
  cp "$TMP" "$ARTIFACT"
  printf 'wrote %s\n' "$ARTIFACT"
  # The generated clients are derived from this artifact, so rewriting it without them leaves the
  # tree internally inconsistent.
  scripts/check-sdk-ts --write
  exec scripts/check-sdk-python --write
fi
if [[ $# -gt 0 ]]; then
  printf 'unknown argument: %s\n' "$1" >&2
  exit 2
fi
if ! cmp -s "$TMP" "$ARTIFACT"; then
  printf 'tool surface drift: %s does not match ToolSurfaceSpec.swift\n' "$ARTIFACT" >&2
  printf 'run scripts/check-tool-surface --write to regenerate it\n' >&2
  exit 1
fi
printf '%s\n' "$ARTIFACT"
