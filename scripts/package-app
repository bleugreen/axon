#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -n "${SWIFT:-}" ]]; then
  SWIFT="$SWIFT"
elif [[ -x "$HOME/.swiftly/bin/swift" ]]; then
  SWIFT="$HOME/.swiftly/bin/swift"
else
  SWIFT="$(command -v swift)"
fi

CARGO="${CARGO:-cargo}"

VERSION="${AXON_VERSION:-$("$ROOT/scripts/check-version")}"
DIST_DIR="$ROOT/dist"
DAEMON_APP_NAME="Axon"
EDITOR_APP_NAME="Axon Editor"
MENU_APP_NAME="Axon Menu"
DAEMON_BUNDLE_ID="${AXON_BUNDLE_ID:-com.bleugreen.axon}"
EDITOR_BUNDLE_ID="${AXON_EDITOR_BUNDLE_ID:-com.bleugreen.axon.editor}"
MENU_BUNDLE_ID="${AXON_MENU_BUNDLE_ID:-com.bleugreen.axon.menu}"
DAEMON_APP_DIR="$DIST_DIR/$DAEMON_APP_NAME.app"
# Layout:
#   Contents/MacOS/Axon                         the Rust daemon (axon-mac): the bundle's main
#                                               executable and its only TCC subject
#   Contents/Resources/bin/axon                 the Swift CLI, a client of the daemon
#   Contents/Library/Applications/Axon Menu.app   the unprivileged menu bar shell
#   Contents/Library/Applications/Axon Editor.app the .axn editor
# The nested apps ship inside the daemon bundle: one draggable app means a Finder replace on an
# existing install, one bundle for the in-app updater to swap, and no way for the pieces to reach
# different versions. Each nested app is its own TCC subject holding no grant; the outer bundle
# keeps the identity every grant is recorded against.
EDITOR_APP_DIR="$DAEMON_APP_DIR/Contents/Library/Applications/$EDITOR_APP_NAME.app"
MENU_APP_DIR="$DAEMON_APP_DIR/Contents/Library/Applications/$MENU_APP_NAME.app"
ICON_SOURCE="$ROOT/Assets/Axon.icns"
MENU_BAR_ICON_SOURCE="$ROOT/Assets/AxonMenuBarTemplate.png"
DAEMON_ENTITLEMENTS="$ROOT/Assets/Axon.entitlements"

cd "$ROOT"

# The daemon. Built for the same minimum system the bundle declares, so the binary never asks for
# a newer macOS than LSMinimumSystemVersion promises.
(cd "$ROOT/rust" && MACOSX_DEPLOYMENT_TARGET=14.0 "$CARGO" build --release --locked -p axon-mac)
RUST_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/rust/target}"
DAEMON_BINARY="$RUST_TARGET_DIR/release/axon-mac"

# One product per invocation: given several `--product` flags, SwiftPM builds only the last.
for product in axon AxonEditorApp AxonMenuApp; do
  "$SWIFT" build -c release --product "$product"
done

# The sibling editor path is where releases before the nesting change left a bundle. Clearing it
# keeps a stale copy out of the archive and out of the release job's verification.
rm -rf "$DAEMON_APP_DIR" "$DIST_DIR/$EDITOR_APP_NAME.app"

write_daemon_info_plist() {
  local plist_path="$1"
  cat > "$plist_path" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>Axon</string>
  <key>CFBundleIdentifier</key>
  <string>$DAEMON_BUNDLE_ID</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleIconFile</key>
  <string>Axon</string>
  <key>CFBundleName</key>
  <string>Axon</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$VERSION</string>
  <key>CFBundleVersion</key>
  <string>$VERSION</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSUIElement</key>
  <true/>
  <key>NSAppleEventsUsageDescription</key>
  <string>Axon uses browser automation to navigate and enumerate browser windows and tabs.</string>
</dict>
</plist>
PLIST
}

write_editor_info_plist() {
  local plist_path="$1"
  cat > "$plist_path" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>AxonEditor</string>
  <key>CFBundleIdentifier</key>
  <string>$EDITOR_BUNDLE_ID</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleIconFile</key>
  <string>Axon</string>
  <key>CFBundleName</key>
  <string>Axon Editor</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Axon Recipe</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.bleugreen.axon.recipe</string>
      </array>
    </dict>
  </array>
  <key>CFBundleShortVersionString</key>
  <string>$VERSION</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Axon Editor</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>axon</string>
      </array>
    </dict>
  </array>
  <key>CFBundleVersion</key>
  <string>$VERSION</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSUIElement</key>
  <false/>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.bleugreen.axon.recipe</string>
      <key>UTTypeDescription</key>
      <string>Axon Recipe</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.yaml</string>
        <string>public.text</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>axn</string>
        </array>
        <key>public.mime-type</key>
        <string>text/vnd.axon.recipe</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
PLIST
}

# No document types, no URL types, no usage strings, and (at signing) no entitlements: the shell
# asks macOS for nothing, so nothing is ever recorded against it.
write_menu_info_plist() {
  local plist_path="$1"
  cat > "$plist_path" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>AxonMenu</string>
  <key>CFBundleIdentifier</key>
  <string>$MENU_BUNDLE_ID</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleIconFile</key>
  <string>Axon</string>
  <key>CFBundleName</key>
  <string>Axon Menu</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$VERSION</string>
  <key>CFBundleVersion</key>
  <string>$VERSION</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
PLIST
}

copy_icon() {
  if [[ -f "$ICON_SOURCE" ]]; then
    cp "$ICON_SOURCE" "$1/Axon.icns"
  fi
}

mkdir -p "$DAEMON_APP_DIR/Contents/MacOS" "$DAEMON_APP_DIR/Contents/Resources/bin"
cp "$DAEMON_BINARY" "$DAEMON_APP_DIR/Contents/MacOS/Axon"
cp "$ROOT/.build/release/axon" "$DAEMON_APP_DIR/Contents/Resources/bin/axon"
chmod 755 "$DAEMON_APP_DIR/Contents/MacOS/Axon" "$DAEMON_APP_DIR/Contents/Resources/bin/axon"
copy_icon "$DAEMON_APP_DIR/Contents/Resources"
write_daemon_info_plist "$DAEMON_APP_DIR/Contents/Info.plist"

mkdir -p "$MENU_APP_DIR/Contents/MacOS" "$MENU_APP_DIR/Contents/Resources"
cp "$ROOT/.build/release/AxonMenuApp" "$MENU_APP_DIR/Contents/MacOS/AxonMenu"
chmod 755 "$MENU_APP_DIR/Contents/MacOS/AxonMenu"
copy_icon "$MENU_APP_DIR/Contents/Resources"
cp "$MENU_BAR_ICON_SOURCE" "$MENU_APP_DIR/Contents/Resources/AxonMenuBarTemplate.png"
write_menu_info_plist "$MENU_APP_DIR/Contents/Info.plist"

mkdir -p "$EDITOR_APP_DIR/Contents/MacOS" "$EDITOR_APP_DIR/Contents/Resources"
cp "$ROOT/.build/release/AxonEditorApp" "$EDITOR_APP_DIR/Contents/MacOS/AxonEditor"
chmod 755 "$EDITOR_APP_DIR/Contents/MacOS/AxonEditor"
copy_icon "$EDITOR_APP_DIR/Contents/Resources"
write_editor_info_plist "$EDITOR_APP_DIR/Contents/Info.plist"

SIGN_IDENTITY="${AXON_CODESIGN_IDENTITY:-}"
if [[ -z "$SIGN_IDENTITY" ]]; then
  SIGN_IDENTITY="$(/usr/bin/security find-identity -v -p codesigning 2>/dev/null \
    | awk '/"Developer ID Application:|"Apple Development:|"Mac Developer:/ { print $2; exit }')"
fi
if [[ -z "$SIGN_IDENTITY" ]]; then
  SIGN_IDENTITY="-"
fi

SIGN_ARGS=(--force --options runtime --sign "$SIGN_IDENTITY")
if [[ "$SIGN_IDENTITY" != "-" ]]; then
  SIGN_ARGS+=(--timestamp)
fi

# The hardened runtime forbids sending Apple events unless the signature carries the Automation
# entitlement, and forbids it silently: no consent dialog, no TCC row, no Automation pane entry.
# Only the daemon sends them, so only its signature gets the entitlement — the CLI, the menu, and
# the editor stay at the empty entitlement set the runtime gives them by default.
DAEMON_SIGN_ARGS=("${SIGN_ARGS[@]}" --entitlements "$DAEMON_ENTITLEMENTS")

# Signed inside-out: every nested piece is sealed before the code that contains it, so the outer
# signature covers final bytes. Signing the outer bundle before a nested app would invalidate it
# the moment that app was signed. The outer bundle's own signature is the one macOS reads the
# entitlement from, because signing a bundle re-signs its main executable in place.
/usr/bin/codesign "${SIGN_ARGS[@]}" "$DAEMON_APP_DIR/Contents/Resources/bin/axon"
/usr/bin/codesign "${SIGN_ARGS[@]}" "$EDITOR_APP_DIR/Contents/MacOS/AxonEditor"
/usr/bin/codesign "${SIGN_ARGS[@]}" "$EDITOR_APP_DIR"
/usr/bin/codesign "${SIGN_ARGS[@]}" "$MENU_APP_DIR/Contents/MacOS/AxonMenu"
/usr/bin/codesign "${SIGN_ARGS[@]}" "$MENU_APP_DIR"
/usr/bin/codesign "${DAEMON_SIGN_ARGS[@]}" "$DAEMON_APP_DIR/Contents/MacOS/Axon"
/usr/bin/codesign "${DAEMON_SIGN_ARGS[@]}" "$DAEMON_APP_DIR"

# Asserted at the point of signing so that no caller of this script can ship a bundle whose
# Automation surface is dead, or whose menu or editor holds an entitlement.
"$ROOT/scripts/check-app-entitlements" "$DAEMON_APP_DIR"

# Named with the version and the target, matching the Rust archives, so a consumer pinning a
# release can name every artifact it needs without guessing. The archive root is the app itself:
# extracting it yields one Axon.app to drag into /Applications, where Finder offers a replace.
ZIP_PATH="$DIST_DIR/Axon-$VERSION-macos-aarch64.zip"
archive_app() {
  rm -f "$ZIP_PATH"
  (cd "$DIST_DIR" && /usr/bin/ditto -c -k --norsrc --noextattr --keepParent "$DAEMON_APP_NAME.app" "$ZIP_PATH")
}
archive_app

if [[ -n "${AXON_NOTARY_PROFILE:-}" ]]; then
  /usr/bin/xcrun notarytool submit "$ZIP_PATH" \
    --keychain-profile "$AXON_NOTARY_PROFILE" \
    --wait
  # The outer bundle is the only stapling target: its ticket covers the nested apps.
  /usr/bin/xcrun stapler staple "$DAEMON_APP_DIR"
  archive_app
elif [[ -n "${AXON_NOTARY_KEY_PATH:-}" || -n "${AXON_NOTARY_KEY_ID:-}" || -n "${AXON_NOTARY_ISSUER:-}" ]]; then
  if [[ -z "${AXON_NOTARY_KEY_PATH:-}" || -z "${AXON_NOTARY_KEY_ID:-}" || -z "${AXON_NOTARY_ISSUER:-}" ]]; then
    printf 'AXON_NOTARY_KEY_PATH, AXON_NOTARY_KEY_ID, and AXON_NOTARY_ISSUER must be set together\n' >&2
    exit 1
  fi
  /usr/bin/xcrun notarytool submit "$ZIP_PATH" \
    --key "$AXON_NOTARY_KEY_PATH" \
    --key-id "$AXON_NOTARY_KEY_ID" \
    --issuer "$AXON_NOTARY_ISSUER" \
    --wait
  /usr/bin/xcrun stapler staple "$DAEMON_APP_DIR"
  archive_app
fi

SHA256="$(/usr/bin/shasum -a 256 "$ZIP_PATH" | awk '{ print $1 }')"
printf '%s  %s\n' "$SHA256" "$(basename "$ZIP_PATH")" > "$ZIP_PATH.sha256"

# The Homebrew cask is written by the release workflow's publish job alone.
printf 'app: %s\n' "$DAEMON_APP_DIR"
printf 'menu app: %s\n' "$MENU_APP_DIR"
printf 'editor app: %s\n' "$EDITOR_APP_DIR"
printf 'zip: %s\n' "$ZIP_PATH"
printf 'sha256: %s\n' "$SHA256"
