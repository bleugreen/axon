#!/usr/bin/env bash
# Builds a release archive for one of the Rust daemons.
#
# Usage: scripts/package-rust <axon-win|axon-linux> [--stage-only|--archive-only]
#
# Archives are named with both the version and the target, because a consumer pins an exact
# release and has to be able to name the artifact it wants without guessing. Nothing here resolves
# a mutable "latest".
#
# Packaging has two phases with the staging directory as the handoff between them: staging builds
# the binary and lays out the directory that becomes the archive, archiving compresses that
# directory and writes the checksum. They run together by default. They are separable because
# code signing has to happen in between — a signature applied after archiving would not be inside
# the archive a consumer downloads, and one applied after checksumming would make the checksum
# describe bytes that no longer exist. See docs/embedding.md for the release-signing contract.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

usage() {
  printf 'usage: scripts/package-rust <axon-win|axon-linux> [--stage-only|--archive-only]\n' >&2
  exit 2
}

CRATE="${1:-}"
PHASE="${2:---all}"
VERSION="$("$ROOT/scripts/check-version")"
DIST_DIR="$ROOT/dist"

case "$CRATE" in
  axon-win)
    TARGET="windows-x86_64"
    BINARY="axon-win.exe"
    EXPECTED_HOST="windows"
    ;;
  axon-linux)
    TARGET="linux-x86_64"
    BINARY="axon-linux"
    EXPECTED_HOST="linux"
    ;;
  *)
    usage
    ;;
esac

case "$PHASE" in
  --all)
    DO_STAGE=1
    DO_ARCHIVE=1
    ;;
  --stage-only)
    DO_STAGE=1
    DO_ARCHIVE=0
    ;;
  --archive-only)
    DO_STAGE=0
    DO_ARCHIVE=1
    ;;
  *)
    usage
    ;;
esac

# Each daemon builds natively, so the host decides what is actually inside the archive. Without
# this check a macOS build would happily produce a file named linux-x86_64 containing a Mach-O
# binary, and the name a consumer pins would be a lie.
case "$(uname -s)" in
  Linux) HOST="linux" ;;
  Darwin) HOST="macos" ;;
  MINGW* | MSYS* | CYGWIN* | Windows_NT) HOST="windows" ;;
  *) HOST="unknown" ;;
esac
if [[ "$HOST" != "$EXPECTED_HOST" ]]; then
  printf '%s must be packaged on %s; this host is %s\n' "$CRATE" "$EXPECTED_HOST" "$HOST" >&2
  exit 1
fi

STAGING="$DIST_DIR/$CRATE-$VERSION-$TARGET"

if [[ "$DO_STAGE" == 1 ]]; then
  rm -rf "$STAGING"
  mkdir -p "$STAGING"

  (cd rust && cargo build --release --locked -p "$CRATE")
  cp "rust/target/release/$BINARY" "$STAGING/$BINARY"
  chmod 755 "$STAGING/$BINARY"

  # The unit template ships with the binary: `daemon install` renders it, so a consumer who wants
  # to inspect what will be registered before installing can read it out of the archive.
  if [[ "$CRATE" == "axon-linux" ]]; then
    mkdir -p "$STAGING/systemd"
    cp rust/axon-linux/systemd/axon.service.in "$STAGING/systemd/axon.service.in"
  fi

  printf 'staged: %s\n' "$STAGING"
fi

if [[ "$DO_ARCHIVE" == 0 ]]; then
  exit 0
fi

# Archiving whatever happens to be on disk would let a stale directory from an earlier version, or
# an empty one, become a release. The staging phase has to have run for this version.
if [[ ! -f "$STAGING/$BINARY" ]]; then
  printf '%s not found; run scripts/package-rust %s --stage-only first\n' "$STAGING/$BINARY" "$CRATE" >&2
  exit 1
fi

sha256_of() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{ print $1 }'
  else
    sha256sum "$1" | awk '{ print $1 }'
  fi
}

cd "$DIST_DIR"
BASENAME="$(basename "$STAGING")"
if [[ "$CRATE" == "axon-win" ]]; then
  ARCHIVE="$BASENAME.zip"
  rm -f "$ARCHIVE"
  if command -v zip >/dev/null 2>&1; then
    zip -qr "$ARCHIVE" "$BASENAME"
  elif command -v powershell >/dev/null 2>&1; then
    powershell -NoProfile -Command "Compress-Archive -Path '$BASENAME' -DestinationPath '$ARCHIVE' -Force"
  else
    printf 'no zip or powershell available to build %s\n' "$ARCHIVE" >&2
    exit 1
  fi
else
  ARCHIVE="$BASENAME.tar.gz"
  rm -f "$ARCHIVE"
  tar -czf "$ARCHIVE" "$BASENAME"
fi

SHA256="$(sha256_of "$ARCHIVE")"
printf '%s  %s\n' "$SHA256" "$ARCHIVE" > "$ARCHIVE.sha256"

printf 'archive: %s\n' "$DIST_DIR/$ARCHIVE"
printf 'sha256: %s\n' "$SHA256"
