#!/usr/bin/env bash
# Stops a macOS live probe's candidate -- its private launchd jobs, then any process still running
# one of its executables -- and fails if any survive.
#
# The probe launches the candidate as launchd gui-domain jobs under labels no installed Axon uses,
# so the jobs are the first thing to remove: `launchctl bootout` stops what launchd is running and
# unloads the label, which is also what lets the next run's bootstrap succeed instead of failing
# as already loaded. A label that is not loaded is the normal answer and is fine. A label that is
# still loaded after its bootout is reported, because the next bootstrap would fail on it.
#
# The process sweep is the fallback for what launchd no longer tracks: a candidate from a killed
# runner whose job was unloaded around it, or one an older lane started without launchd at all.
# Such a process outlives its job and survives the next checkout, because deleting an executable
# does not change a running process's argv, so it keeps matching the same pattern.
#
# Every pattern is a path under the job's own workspace, and every label is one the lane alone
# uses, which is what keeps this from ever reaching an installed copy of Axon. It is the macOS
# counterpart of the Windows job's `Remove leaked live-probe daemons`.
#
# macOS only, and load-bearingly so. The patterns arrive as arguments, so they are in the command
# line of this very script and of the shell that invoked it. BSD `pgrep` excludes itself and all of
# its ancestors from the match list by default, which is the only reason `pkill -f` below does not
# kill this script and take the whole step with it. Two consequences for anyone editing this:
# adding `-a` to either invocation restores the ancestors and turns the sweep suicidal, and procps
# `pgrep` on Linux excludes only itself, so this cannot be reused by the Linux lane as written.
# `pgrep -f` also reads each path as a regular expression, which is harmless for a workspace path
# but would need quoting for one carrying metacharacters.
#
# Usage: scripts/stop-probe-app [--launchd-label LABEL]... <executable-path>...
set -euo pipefail

usage() {
  printf 'usage: %s [--launchd-label LABEL]... <executable-path>...\n' "$0" >&2
  exit 2
}

# Validated in full before anything is stopped, so a malformed call stops nothing.
expect_label=false
executables=0
for argument in "$@"; do
  if [[ "$expect_label" == true ]]; then
    expect_label=false
    continue
  fi
  case "$argument" in
    --launchd-label) expect_label=true ;;
    -*) usage ;;
    *) executables=$((executables + 1)) ;;
  esac
done
if [[ "$expect_label" == true || "$executables" == 0 ]]; then
  usage
fi

uid="$(id -u)"
failed=false

expect_label=false
for argument in "$@"; do
  if [[ "$expect_label" == true ]]; then
    expect_label=false
    launchctl bootout "gui/$uid/$argument" >/dev/null 2>&1 || true
    if launchctl print "gui/$uid/$argument" >/dev/null 2>&1; then
      printf '::error::%s is still loaded after launchctl bootout\n' "$argument"
      failed=true
    fi
    continue
  fi
  [[ "$argument" == --launchd-label ]] && expect_label=true
done

running() {
  pgrep -f "$1" 2>/dev/null || true
}

expect_label=false
for argument in "$@"; do
  if [[ "$expect_label" == true ]]; then
    expect_label=false
    continue
  fi
  if [[ "$argument" == --launchd-label ]]; then
    expect_label=true
    continue
  fi
  remaining="$(running "$argument")"
  if [[ -z "$remaining" ]]; then
    continue
  fi
  printf 'stopping probe app processes: %s\n' "$(printf '%s' "$remaining" | tr '\n' ' ')"
  # TERM first so a process with state to flush can take it, then KILL, because a wedged process
  # is exactly the case this exists for and it may not be answering its run loop either.
  for signal in TERM KILL; do
    pkill -"$signal" -f "$argument" >/dev/null 2>&1 || true
    for _ in {1..20}; do
      remaining="$(running "$argument")"
      if [[ -z "$remaining" ]]; then
        break 2
      fi
      sleep 0.25
    done
  done
  if [[ -n "$remaining" ]]; then
    printf '::error::%s is still running as pid(s) %s after TERM and KILL; this runner needs attention before the next live run\n' \
      "$argument" "$(printf '%s' "$remaining" | tr '\n' ' ')"
    failed=true
  fi
done

if [[ "$failed" == true ]]; then
  exit 1
fi
