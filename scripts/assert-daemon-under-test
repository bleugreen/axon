#!/usr/bin/env bash
# Asserts that a daemon a live probe just spawned is the one serving the Axon socket.
#
# The socket is a rendezvous, not a proof of authorship. Every subcommand except `serve` is a
# client, so a probe that starts its own daemon and then talks to the socket is answered by
# whichever daemon holds it. On a live runner that is routinely somebody's installed release: the
# spawned `serve` exits immediately with AddrInUse, and because a probe backgrounds it, `set -e`
# never sees that. Every assertion after it then passes on evidence about a binary nobody changed,
# which is worse than no lane at all, because the lane is trusted.
#
# The health document reports the serving process's own pid, so requiring it to equal the pid that
# was spawned is the exact check: it fails when the bind was lost to another daemon, when the
# daemon died after binding, and when a stale daemon was left behind by an earlier run.
#
# The expected pid is the caller's to establish, from whatever started the daemon: a probe that
# backgrounds `serve` passes `$!`, and the macOS probe, which launches its candidate as a launchd
# job under a label of its own, passes the pid `launchctl print` names for that label. Neither is a
# process-table search, which could only guess between a candidate and a leftover.
#
# The log is optional because not every daemon under test has one: a probe passes the file it
# redirected `serve` to, or the macOS probe the job's StandardErrorPath.
#
# `--launchd-label` names the gui-domain job that started the daemon. Liveness is then launchd's
# answer, read fresh on every iteration, rather than `kill -0` on a pid captured once: a pid read
# while launchd is still spawning the job is not proof of anything either way, and launchd's record
# is also what explains a death. A single read that no longer names the pid is read again before
# it is called an exit. Every failure then prints scripts/launchd-job-evidence for the label while
# it is still loaded, because a daemon that dies before writing to its log leaves nothing else.
#
# `<daemon-binary>` is any Axon CLI that can ask for `status --json`; it reaches whichever endpoint
# AXON_SOCKET_PATH names, so a probe serving a private socket exports that first.
#
# Usage: scripts/assert-daemon-under-test [--launchd-label LABEL] <daemon-binary> <pid> [daemon-log]
set -euo pipefail

usage() {
  printf 'usage: %s [--launchd-label LABEL] <daemon-binary> <pid> [daemon-log]\n' "$0" >&2
  exit 2
}

LABEL=""
if [[ "${1:-}" == --launchd-label ]]; then
  [[ $# -ge 2 && -n "$2" ]] || usage
  LABEL="$2"
  shift 2
fi
if [[ $# -lt 2 || $# -gt 3 ]]; then
  usage
fi

DAEMON="$1"
EXPECTED_PID="$2"
LOG="${3:-}"
SCRIPTS="$(cd "$(dirname "$0")" && pwd)"

fail() {
  printf '::error::%s\n' "$1"
  if [[ -n "$LABEL" ]]; then
    if [[ -n "$LOG" ]]; then
      "$SCRIPTS/launchd-job-evidence" --pid "$EXPECTED_PID" "$LABEL" "$LOG" || true
    else
      "$SCRIPTS/launchd-job-evidence" --pid "$EXPECTED_PID" "$LABEL" || true
    fi
  elif [[ -n "$LOG" && -f "$LOG" ]]; then
    printf -- '--- %s ---\n' "$LOG"
    cat "$LOG"
  fi
  exit 1
}

launchd_pid() {
  launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | awk '/^[[:space:]]*pid = / { print $3; exit }' || true
}

# Sets `current` to what was observed, for the message when it is not the daemon under test.
alive() {
  if [[ -n "$LABEL" ]]; then
    current="$(launchd_pid)"
    [[ "$current" == "$EXPECTED_PID" ]]
  else
    current=""
    kill -0 "$EXPECTED_PID" 2>/dev/null
  fi
}

exited() {
  if [[ -z "$LABEL" ]]; then
    fail "the daemon under test (pid $EXPECTED_PID) exited instead of serving the socket"
  elif [[ -z "$current" ]]; then
    fail "the daemon under test (pid $EXPECTED_PID) exited instead of serving the socket; launchd no longer runs $LABEL"
  else
    fail "the daemon under test (pid $EXPECTED_PID) exited instead of serving the socket; launchd now runs $LABEL as pid $current"
  fi
}

# The daemon binds its socket only after the accessibility backend finishes starting, so a probe's
# first request has to wait for it.
status=""
current=""
missed=false
for _ in {1..80}; do
  if ! alive; then
    if [[ "$missed" == true ]]; then
      exited
    fi
    missed=true
    sleep 0.25
    continue
  fi
  missed=false
  status="$("$DAEMON" status --json 2>/dev/null || true)"
  if printf '%s' "$status" | jq -e '.daemon.running and .daemon.ready' >/dev/null 2>&1; then
    break
  fi
  status=""
  sleep 0.25
done

if [[ -z "$status" && "$missed" == true ]]; then
  exited
fi
if [[ -z "$status" ]]; then
  fail "the daemon under test (pid $EXPECTED_PID) never became ready"
fi

endpoint="$(printf '%s' "$status" | jq -r '.daemon.endpoint')"
served_pid="$(printf '%s' "$status" | jq -r '.daemon.processId // "unknown"')"
if [[ "$served_pid" != "$EXPECTED_PID" ]]; then
  fail "$endpoint is served by pid $served_pid, not the daemon under test (pid $EXPECTED_PID); every assertion after this would describe that daemon instead of this build"
fi

printf 'the daemon under test (pid %s) is serving %s\n' "$EXPECTED_PID" "$endpoint"
